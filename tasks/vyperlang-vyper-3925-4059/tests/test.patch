+        0x02,  # top-level array length
+        0x40,  # head of DAr[DAr[DAr, uint256]]][0]
+        0xE0,  # head of DAr[DAr[DAr, uint256]]][1]
+        0x01,  # DAr[DAr[DAr, uint256]]][0] length
+        # head of DAr[DAr[DAr, uint256]]][0][0]
+        # points to DAr[DAr[DAr, uint256]]][1][0]
